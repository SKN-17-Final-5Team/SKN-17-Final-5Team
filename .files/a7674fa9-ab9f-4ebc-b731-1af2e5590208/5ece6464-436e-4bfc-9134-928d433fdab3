<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Proforma Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 60px 80px;
            font-size: 10pt;
            line-height: 1.3;
        }

        h1 {
            text-align: left;
            margin-top: 0;
            margin-bottom: 5px;
            font-size: 24pt;
            font-weight: normal;
            text-transform: uppercase;
        }

        .header-line {
            border-top: 2px solid #000;
            border-bottom: 1px solid #000;
            height: 2px;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 5px;
            vertical-align: top;
        }

        .section-header {
            background-color: #d9d9d9;
            /* Light gray background */
            font-weight: bold;
            padding: 5px;
        }

        .no-border-bottom {
            border-bottom: none;
        }

        .no-border-top {
            border-top: none;
        }

        .items-header th {
            font-weight: normal;
            text-align: left;
            vertical-align: top;
        }

        .items-body td {
            height: 200px;
            /* Fixed height for the empty body */
        }

        .footer-section {
            margin-top: 20px;
        }

        .footer-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .footer-item {
            flex: 1;
        }

        .declaration {
            margin-top: 20px;
            margin-bottom: 40px;
        }

        .signature-row {
            display: flex;
            justify-content: space-between;
            margin-top: 40px;
        }
    </style>
</head>

<body>
    <h1>PROFORMA INVOICE</h1>
    <div class="header-line"></div>

    <table>
        <!-- Proforma Invoice Header -->
        <tr>
            <td colspan="2" class="section-header">Proforma Invoice</td>
        </tr>
        <tr>
            <td colspan="2">
                Date: 2025-10-01<br>
                Proforma invoice #: PI-K-BEAUTY/2025
            </td>
        </tr>

        <!-- SENT BY -->
        <tr>
            <td colspan="2" class="section-header">SENT BY</td>
        </tr>
        <tr>
            <td colspan="2" style="height: 100px;">
                Company Name: K-BEAUTY EXPORTS CO., LTD.<br>
                Name/Department: Export Dept.<br>
                Address: 25, Gasan digital 1-ro, Geumcheon-gu, Seoul, Republic of Korea<br>
                City/Postal Code: Seoul<br>
                Country: Republic of Korea<br>
                Tel./Fax No.: +82 10-1234-5678
            </td>
        </tr>

        <!-- SENT TO & Bill of Lading No -->
        <tr>
            <td class="section-header" style="width: 50%;">SENT TO</td>
            <td class="section-header" style="width: 50%;">Bill of Lading No</td>
        </tr>
        <tr>
            <td style="height: 100px;">
                Company Name: Nasa-SKN17<br>
                Name/Department: Purchasing Dept.<br>
                Address: 1200 12th Avenue South, Suite 1200, Seattle, Washington, USA<br>
                City/Postal Code: Seattle<br>
                Country: USA<br>
                Phone No.: +1 (305) 777-8888
            </td>
            <td>
                Number of pieces: 22,000 pcs<br>
                Total Gross Weight: 3,150kg<br>
                Total Net Weight: 3,000kg<br>
                Carrier: Vessel
            </td>
        </tr>
    </table>

    <!-- Items Table -->
    <table style="margin-top: -21px;"> <!-- Overlap borders -->
        <tr class="items-header">
            <td style="width: 30%;">Description of goods</td>
            <td style="width: 15%;">Commodity Code</td>
            <td style="width: 15%;">Country of origin</td>
            <td style="width: 10%;">Quantity</td>
            <td style="width: 15%;">Unit Value, Currency</td>
            <td style="width: 15%;">Subtotal value, Currency</td>
        </tr>
        <tr class="items-body">
            <td>1) Premium Facial Cream 50ml<br>2) Hydrating Toner 200ml</td>
            <td>3304.99<br>3304.99</td>
            <td>Republic of Korea<br>Republic of Korea</td>
            <td>10,000 pcs<br>12,000 pcs</td>
            <td>USD 4.20<br>USD 3.10</td>
            <td>USD 42,000.00<br>USD 37,200.00</td>
        </tr>
        <tr>
            <td colspan="5" style="text-align: right;">Total value, currency</td>
            <td>USD 79,200.00</td>
        </tr>
    </table>

    <div class="footer-section">
        <div class="footer-row">
            <div class="footer-item">Term of transportation: Vessel</div>
            <div class="footer-item">Reason for export: Export of beauty products</div>
        </div>

        <div class="declaration">
            I declare that the information mentioned above is true and correct to the best of my knowledge.
        </div>

        <div class="signature-row">
            <div class="footer-item">Signature:</div>
            <div class="footer-item" style="text-align: right; padding-right: 100px;">Stamp:</div>
        </div>

        <div style="margin-top: 40px;">
            Name:
        </div>
    </div>

</body>

</html>